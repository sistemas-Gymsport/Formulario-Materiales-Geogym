[Unit]
Description=GEO GYM - API de solicitudes de materiales
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=geogym
Group=geogym
WorkingDirectory=/opt/geogym-materiales/backend
EnvironmentFile=/opt/geogym-materiales/backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geogym-backend
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/geogym-materiales
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
